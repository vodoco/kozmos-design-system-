{
  "ci": {
    "collect": {
      "staticDistDir": "./apps/docs/storybook-static",
      "numberOfRuns": 1,
      "url": [
        "http://localhost/iframe.html?id=components-button--default&viewMode=story",
        "http://localhost/iframe.html?id=components-dialog--default&viewMode=story",
        "http://localhost/iframe.html?id=feedback-toast--default&viewMode=story",
        "http://localhost/vue/iframe.html?id=vue-poicard--default&viewMode=story"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
