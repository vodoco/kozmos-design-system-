{
    "name": "@kozmos/vue",
    "version": "0.0.1",
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/kozmos-vue.umd.js",
    "module": "dist/kozmos-vue.es.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/kozmos-vue.es.js",
            "require": "./dist/kozmos-vue.umd.js"
        }
    },
    "scripts": {
        "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
        "dev": "vite build --watch",
        "test": "vitest run"
    },
    "peerDependencies": {
        "vue": "^3.0.0",
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "dependencies": {
        "@kozmos/react": "workspace:*"
    },
    "devDependencies": {
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@vitejs/plugin-vue": "^5.0.4",
        "typescript": "^5.2.2",
        "vite": "^5.2.0",
        "vite-plugin-dts": "^3.9.1",
        "vue": "^3.4.21",
        "vue-tsc": "^2.0.7"
    }
}
