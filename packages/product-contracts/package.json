{
  "name": "@kozmos/product-contracts",
  "version": "0.0.1",
  "description": "Platform-neutral presentation contracts for Kozmos map, POI, floor, and routing components.",
  "keywords": [
    "kozmos",
    "design-system",
    "types",
    "maps",
    "poi",
    "wayfinding"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
