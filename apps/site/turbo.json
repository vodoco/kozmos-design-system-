{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "public/**",
        "package.json",
        "react-router.config.ts",
        "tsconfig.json",
        "vite.config.ts"
      ],
      "outputs": ["build/**"]
    },
    "test": {
      "inputs": ["src/**", "scripts/**", "package.json"],
      "outputs": []
    }
  }
}
